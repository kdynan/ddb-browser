{
  "name": "ddb-browser",
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "vite build && tsx server/index.ts",
    "serve": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "build:desktop": "vite build && esbuild electron/main.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/main.cjs",
    "desktop": "npm run build:desktop && electron .",
    "dist": "npm run build:desktop && electron-builder",
    "dist:win": "npm run build:desktop && electron-builder --win zip -c.win.signAndEditExecutable=false"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1149.0",
    "@aws-sdk/credential-providers": "^3.1149.0",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lint": "^6.9.7",
    "@hono/node-server": "^2.1.4",
    "@smithy/shared-ini-file-loader": "^4.7.2",
    "@tanstack/react-query": "^5.104.1",
    "@uiw/react-codemirror": "^4.25.12",
    "hono": "^4.13.13",
    "lucide-react": "^1.54.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "private": true,
  "type": "module",
  "productName": "DDB Browser",
  "description": "Desktop browser for DynamoDB",
  "author": "Keith Dynan",
  "main": "dist-electron/main.cjs",
  "build": {
    "appId": "com.kdynan.ddb-browser",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json",
      "!node_modules"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "executableName": "ddb-browser"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "artifactName": "ddb-browser-${version}-${os}-${arch}.${ext}"
  }
}
